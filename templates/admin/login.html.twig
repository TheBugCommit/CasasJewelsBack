{% extends 'base.html.twig' %}

{% block title %}Backoffice — Accés{% endblock %}

{% block body %}
    <div class="container min-vh-70-center">
        <div class="card shadow-sm max-width-100">
            <div class="card-body p-4 p-md-5">
                <h1 class="text-center h3 mb-4 text-dark"><i class="fa-regular fa-building"></i>Backoffice</h1>

                {% if error %}
                    <div class="alert alert-danger p-2 mb-4" role="alert">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <form method="post" action="{{ path('admin_login') }}">
                    <div class="mb-3">
                        <label for="email" class="form-label text-muted small fw-bold">Correu electrònic</label>
                        <input type="email"
                               class="form-control"
                               id="email"
                               name="_username"
                               value="{{ last_username }}"
                               autocomplete="email"
                               required autofocus>
                    </div>

                    <div class="mb-4">
                        <label for="password" class="form-label text-muted small fw-bold">Contrasenya</label>
                        <input type="password"
                               class="form-control"
                               id="password"
                               name="_password"
                               autocomplete="current-password"
                               required>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <button type="submit" class="btn btn-primary w-100 py-2 btn-brand">
                        Accedir
                    </button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
