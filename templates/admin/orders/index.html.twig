{% extends 'base.html.twig' %}
{% import 'admin/components/_alerts.html.twig' as alerts %}

{% block title %}Gestió de Comandes{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0">Llistat de Comandes</h2>
        </div>

        {{ alerts.flash_messages(app.flashes) }}

        {% include 'admin/orders/components/_filters.html.twig' %}

        <div class="d-flex justify-content-end align-items-center mb-2">
            <label for="limitSelect" class="small fw-bold text-muted me-2">Mostra:</label>
            <select id="limitSelect" class="form-select form-select-sm w-auto cursor-pointer" onchange="window.location.href=this.value;">
                {% for limitOption in [10, 20, 50, 100, 500, 1000] %}
                    <option value="{{ path('home', { limit: limitOption, offset: 1 }) }}"
                            {% if currentLimit == limitOption %}selected{% endif %}>
                        {{ limitOption }} comandes
                    </option>
                {% endfor %}
            </select>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-0">
                {% include 'admin/orders/components/_table.html.twig' %}

                {% if totalPages > 1 %}
                    {% include 'admin/components/_pagination.html.twig' with {
                        'route': 'home',
                        'route_params': {'limit': currentLimit},
                        'current_page': currentPage,
                        'total_pages': totalPages
                    } %}
                    <div class="text-center text-muted small pb-3">
                        Mostrant pàgina {{ currentPage }} de {{ totalPages }} (Total: {{ total }} comandes)
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/admin-orders.js') }}"></script>
{% endblock %}
