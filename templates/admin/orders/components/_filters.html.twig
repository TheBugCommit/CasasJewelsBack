<div class="card shadow-sm mb-4">
    <div class="card-body bg-light">
        <form id="ordersFilterForm" class="row g-3" onsubmit="event.preventDefault();">
            <div class="col-md-3">
                <label for="filterId" class="form-label small fw-bold text-muted">ID Comanda</label>
                <input type="text" id="filterId" class="form-control form-control-sm" placeholder="Ex: 123e4567...">
            </div>
            <div class="col-md-3">
                <label for="filterName" class="form-label small fw-bold text-muted">Nom del Client</label>
                <input type="text" id="filterName" class="form-control form-control-sm" placeholder="Cerca per nom...">
            </div>
            <div class="col-md-3">
                <label for="filterStatus" class="form-label small fw-bold text-muted">Estat</label>
                <select id="filterStatus" class="form-select form-select-sm">
                    <option value="">Tots els estats</option>

                    {% for statusValue in order_all_statuses() %}
                        <option value="{{ statusValue }}">
                            {{ order_status_label(statusValue) }}
                        </option>
                    {% endfor %}

                </select>
            </div>
            <div class="col-md-3">
                <label for="filterDate" class="form-label small fw-bold text-muted">Data de Creació</label>
                <input type="date" id="filterDate" class="form-control form-control-sm">
            </div>
        </form>
    </div>
</div>
