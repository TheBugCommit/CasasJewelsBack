<div class="table-responsive table-scrollable">
    <table class="table table-striped table-hover mb-0 align-middle" id="ordersTable">
        <thead class="table-dark sticky-top z-1">
        <tr>
            <th class="ps-3">ID Comanda</th>
            <th>Data de Creació</th>
            <th>Nom del Client</th>
            <th>Estat</th>
            <th class="text-end pe-3">Accions</th>
        </tr>
        </thead>
        <tbody id="ordersTableBody">
        {% for order in orders %}
            <tr class="order-row">
                <td class="ps-3 text-muted small col-id">{{ order.id }}</td>
                <td class="col-date">{{ order.createdAt|date('d/m/Y H:i') }}</td>
                <td class="fw-bold col-name">{{ order.clientName }}</td>
                <td class="col-status" data-status="{{ order.status|lower }}">
                    <span class="badge rounded-pill
                        {% if order.status == 'processing' %}bg-warning text-dark
                        {% elseif order.status == 'delivering' %}bg-primary
                        {% elseif order.status == 'delivered' %}bg-success
                        {% else %}bg-secondary{% endif %}">
                        {{ order.status|upper }}
                    </span>
                </td>
                <td class="text-end pe-3">
                    {% for next_status in transitions[order.status] %}
                        <form action="{{ path('admin_order_update_status', { id: order.id, status: next_status }) }}" method="POST" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('update_status_' ~ order.id) }}">
                            <button type="submit" class="btn btn-sm {{ buttonColors[next_status] }}">
                                Marcar "{{ statusLabels[next_status] }}"
                            </button>
                        </form>
                    {% endfor %}
                    {% if transitions[order.status] is empty %}
                        <span class="text-muted small"><em>Completada</em></span>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr id="no-orders-row">
                <td colspan="5" class="text-center py-4 text-muted">
                    No s'ha trobat cap comanda.
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
