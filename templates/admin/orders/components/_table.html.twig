<div class="table-responsive table-scrollable">
    <table class="table table-striped table-hover mb-0 align-middle" id="ordersTable">
        <thead class="table-dark sticky-top z-1">
        <tr>
            <th scope="col" class="ps-3">ID Comanda</th>
            <th scope="col">Data de Creació</th>
            <th scope="col">Nom del Client</th>
            <th scope="col">Estat</th>
            <th scope="col" class="text-end pe-3">Accions</th>
        </tr>
        </thead>
        <tbody id="ordersTableBody">
        {% for order in orders %}
            <tr class="order-row">
                <td class="ps-3 text-muted small col-id">{{ order.id|slice(0,18) }}...</td>
                <td class="col-date">{{ order.createdAt|date('d/m/Y H:i') }}</td>
                <td class="fw-bold col-name">{{ order.clientName }}</td>

                <td class="col-status" data-status="{{ order.status }}">
                    <span class="badge rounded-pill {{ order_badge_color(order.status) }}">
                        {{ order_status_label(order.status) }}
                    </span>
                </td>

                <td class="text-end pe-3">
                    <div class="d-flex gap-2 justify-content-end align-items-center">
                        <a href="{{ path('admin_order_detail', { id: order.id }) }}" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-eye"></i> Detall
                        </a>

                        {% for next_status in order_allowed_transitions(order.status) %}
                            {% if not (order.status == 'refound_pending' and next_status == 'cancelled') %}
                                <form action="{{ path('admin_order_update_status', { id: order.id, status: next_status }) }}" method="POST" class="m-0">
                                    <input type="hidden" name="_token" value="{{ csrf_token('update_status_' ~ order.id) }}">
                                    <button type="submit" class="btn btn-sm {{ order_button_color(next_status) }}">
                                        {{ order_action_label(next_status) }}
                                    </button>
                                </form>
                            {% endif %}
                        {% endfor %}

                        {% if order.status == 'refound_pending' %}
                            <span class="text-muted small">
                                <em>Stripe... <div class="spinner-border spinner-border-sm text-secondary ms-1" role="status"></div></em>
                            </span>
                        {% elseif order_allowed_transitions(order.status) is empty %}
                            <span class="text-muted small">
                                <em>{% if order.status == 'cancelled' %}Cancel·lada{% else %}Completada{% endif %}</em>
                            </span>
                        {% endif %}
                    </div>
                </td>
            </tr>
        {% else %}
            <tr id="no-orders-row">
                <td colspan="5" class="text-center py-4 text-muted">No s'ha trobat cap comanda.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
