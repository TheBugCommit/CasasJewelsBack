{% extends 'base.html.twig' %}

{% block body %}
    <div class="container py-5">
        <div class="row">
            <div class="col-lg-8 mx-auto">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <a href="{{ path('home') }}" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Tornar al llistat
                    </a>
                    <span class="badge bg-primary">ID: {{ order.id|slice(0,8) }}</span>
                </div>

                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white border-bottom py-3">
                        <h4 class="mb-0">Resum de la Comanda</h4>
                    </div>
                    <div class="card-body">
                        <div class="row mb-4">
                            <div class="col-sm-6">
                                <p class="text-muted mb-1">Dades del Client</p>
                                <h6 class="mb-0">{{ order.clientName }}</h6>
                                <p class="text-secondary small">{{ order.clientEmail }}</p>
                            </div>
                            <div class="col-sm-6 text-sm-end">
                                <p class="text-muted mb-1">Estat actual</p>
                                <span class="badge bg-light text-dark border">{{ order.status.value }}</span>
                            </div>
                        </div>

                        <table class="table table-sm align-middle">
                            <thead class="table-light">
                            <tr>
                                <th>Producte</th>
                                <th class="text-center">Quantitat</th>
                                <th class="text-end">Preu Unitari</th>
                                <th class="text-end">Total</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for line in order.lines %}
                                <tr>
                                    <td>
                                        {% set product = products[line.productId]|default(null) %}

                                        {% if product %}
                                            <strong>{{ product.name }}</strong><br>
                                            <small class="text-muted text-monospace">{{ line.productId }}</small>
                                        {% else %}
                                            <span class="text-danger">Producte no trobat</span><br>
                                            <small class="text-muted text-monospace">{{ line.productId }}</small>
                                        {% endif %}
                                    </td>
                                    <td class="text-center">{{ line.quantity }}</td>
                                    <td class="text-end">{{ line.unitPrice|number_format(2, ',', '.') }} €</td>
                                    <td class="text-end fw-bold">{{ line.total|number_format(2, ',', '.') }} €</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer bg-light border-0 py-3 text-end">
                        <span class="text-muted me-2">Total comanda:</span>
                        <span class="h4 text-success mb-0">{{ order.totalAmount|number_format(2, ',', '.') }} €</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
