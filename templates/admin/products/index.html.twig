{% extends 'base.html.twig' %}

{% block title %}Gestió de Productes{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0">Catàleg de Productes</h2>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createProductModal">
                <i class="fa-regular fa-plus"></i> Nou Producte
            </button>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}

        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Imatge</th>
                            <th>Nom</th>
                            <th>Categoria</th>
                            <th>Preu</th>
                            <th>Descripció</th>
                            <th class="text-end">Accions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for product in products %}
                            <tr>
                                <td class="align-middle" style="width: 80px;">
                                    {% if product.imageUrl %}
                                        <img src="{{ product.imageUrl }}" alt="{{ product.name }}" class="img-thumbnail" style="width:60px; height:60px; object-fit:cover;">
                                    {% else %}
                                        <span class="text-muted small">Sense imatge</span>
                                    {% endif %}
                                </td>
                                <td class="align-middle fw-semibold">{{ product.name }}</td>
                                <td class="align-middle">
                                    <span class="badge bg-secondary">{{ product.category }}</span>
                                </td>
                                <td class="align-middle">{{ product.price|number_format(2, ',', '.') }} €</td>
                                <td class="align-middle text-muted small" style="max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    {{ product.description }}
                                </td>
                                <td class="align-middle text-end">
                                    <form method="post" action="{{ path('admin_product_delete', {id: product.id}) }}"
                                          onsubmit="return confirm('Segur que vols eliminar «{{ product.name }}»?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_product_' ~ product.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fa-regular fa-trash-can"></i> Eliminar
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">No hi ha productes al catàleg.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>

                {% if totalPages > 1 %}
                    <div class="d-flex justify-content-center p-3">
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                {% for page in 1..totalPages %}
                                    <li class="page-item {% if page == currentPage %}active{% endif %}">
                                        <a class="page-link" href="{{ path('admin_products', {limit: currentLimit, offset: page}) }}">{{ page }}</a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </nav>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="modal fade" id="createProductModal" tabindex="-1" aria-labelledby="createProductModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form method="post" action="{{ path('admin_product_create') }}" enctype="multipart/form-data">
                    <input type="hidden" name="_token" value="{{ csrf_token('create_product') }}">
                    <div class="modal-header">
                        <h5 class="modal-title" id="createProductModalLabel">Nou Producte</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label fw-semibold">Nom <span class="text-danger">*</span></label>
                                <input type="text" name="name" class="form-control" required maxlength="255">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Preu (€) <span class="text-danger">*</span></label>
                                <input type="number" name="price" class="form-control" step="0.01" min="0.01" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Categoria <span class="text-danger">*</span></label>
                                <select name="category" class="form-select" required>
                                    <option value="">-- Selecciona --</option>
                                    {% for cat in categories %}
                                        <option value="{{ cat.value }}">{{ cat.value }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Imatge</label>
                                <input type="file" name="image" class="form-control" accept="image/*">
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Descripció <span class="text-danger">*</span></label>
                                <textarea name="description" class="form-control" rows="3" required></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel·lar</button>
                        <button type="submit" class="btn btn-primary">Crear Producte</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
