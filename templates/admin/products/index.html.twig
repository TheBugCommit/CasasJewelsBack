{% extends 'base.html.twig' %}
{% import 'admin/components/_alerts.html.twig' as alerts %}

{% block title %}Gestió de Productes{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0">Catàleg de Productes</h2>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createProductModal">
                <i class="fa-regular fa-plus"></i> Nou Producte
            </button>
        </div>

        {{ alerts.flash_messages(app.flashes) }}

        <div class="card shadow-sm">
            <div class="card-body p-0">

                {% include 'admin/products/components/_table.html.twig' %}

                {% if totalPages > 1 %}
                    {% include 'admin/components/_pagination.html.twig' with {
                        'route': 'admin_products',
                        'route_params': {'limit': currentLimit},
                        'current_page': currentPage,
                        'total_pages': totalPages
                    } %}
                {% endif %}

            </div>
        </div>
    </div>

    {% include 'admin/products/components/_modal_create.html.twig' %}
    {% include 'admin/products/components/_modal_edit.html.twig' %}

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/product-modals.js') }}"></script>
{% endblock %}
