{% extends 'base.html.twig' %}

{% block title %}S'ha produït un error (500){% endblock %}

{% block body %}
    <div class="container min-vh-70-center">
        <div class="text-center">
            <h1 class="display-1 fw-bold text-danger mb-0">500</h1>
            <h2 class="h3 text-dark mb-3">Ups! Alguna cosa no ha anat bé.</h2>
            <p class="text-muted mb-4 lead">
                El nostre servidor ha tingut un problema inesperat intentant processar la teva petició.<br>
                El nostre equip tècnic ja ha estat notificat i ho estem solucionant.
            </p>
            <a href="{{ path('home') }}" class="btn btn-primary px-4 py-2 btn-brand">
                Tornar a l'Inici
            </a>
        </div>
    </div>
{% endblock %}
